---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormNote from '../components/FormNote.astro';
import { site } from '../config/site';

const endpoint = site.forms.hiringEndpoint;
const fallback = `mailto:${site.email}?subject=${encodeURIComponent(
  'Hiring brief',
)}`;
const action = endpoint || fallback;
const isFallback = endpoint.length === 0;
---

<BaseLayout
  title="Hire talent"
  description="Hire digital marketing, social media and marketing analytics talent through Social Magent. Brief us on the role, skills and timeline."
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Hire talent' },
  ]}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">For employers</p>
      <h1>Hire marketing and analytics talent without the guesswork.</h1>
      <p class="lede">
        We focus on digital marketing, social media and marketing analytics
        roles. Tell us the brief and we will be honest about whether we can
        help.
      </p>
      <div class="page-actions">
        <a class="button" href="#hiring-form">Start a hiring brief</a>
        <a class="button button-secondary" href="/contact/">Ask a question</a>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="process-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">The process</p>
          <h2 id="process-heading">Brief, shortlist, interview, hire</h2>
          <p>
            A simple process with clear checkpoints. No mystery pipeline and no
            pressure to hire before you are ready.
          </p>
        </div>
      </div>

      <ol class="process-grid">
        <li class="process-step">
          <span class="process-number" aria-hidden="true">01</span>
          <h3>Brief</h3>
          <p>
            Share the role, skills, location, budget range and timeline. We will
            ask questions before agreeing to work on it.
          </p>
        </li>
        <li class="process-step">
          <span class="process-number" aria-hidden="true">02</span>
          <h3>Shortlist</h3>
          <p>
            We speak with candidates in our network and introduce people whose
            experience fits the brief — with their permission.
          </p>
        </li>
        <li class="process-step">
          <span class="process-number" aria-hidden="true">03</span>
          <h3>Interview</h3>
          <p>
            You run your own process. We help coordinate and keep both sides
            informed, without pretending to make decisions for you.
          </p>
        </li>
        <li class="process-step">
          <span class="process-number" aria-hidden="true">04</span>
          <h3>Hire</h3>
          <p>
            When you make an offer, we help with the handover. Our success fee
            becomes due only after a placement.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <section id="hiring-form" class="section section-divider" aria-labelledby="hiring-form-heading">
    <div class="container split">
      <div>
        <p class="eyebrow">Our niche</p>
        <h2 id="hiring-form-heading">Marketing people who can do the work.</h2>
        <p>
          We are building a network across digital marketing, social media,
          content, performance marketing and marketing analytics. That focus
          means fewer, better-matched conversations.
        </p>

        <h3>How our success fee works</h3>
        <p>
          Employers pay a success fee only when we place someone with you. The
          fee is agreed in writing before work begins and is based on the role
          — there are no prices on this site because every brief is different.
        </p>
        <p>
          We do not charge candidates. If a role is outside our niche, we will
          say so rather than take it on.
        </p>

        <div class="note-strip">
          <p>
            <strong>Need to move quickly?</strong> Tell us your real timeline in
            the form. We will tell you honestly whether we can help within it.
          </p>
        </div>

        <p class="form-privacy">
          Prefer email? Send the brief to
          <a href={`mailto:${site.email}?subject=${encodeURIComponent('Hiring brief')}`}>
            {site.email}
          </a>.
        </p>
      </div>

      <div class="form-card">
        <FormNote endpoint={endpoint} subject="Hiring brief" />

        <form
          action={action}
          method="post"
          enctype={isFallback ? 'text/plain' : undefined}
        >
          <input type="hidden" name="_subject" value="New hiring brief" />
          <div class="honeypot" aria-hidden="true">
            <label for="hire-gotcha">Leave this field empty</label>
            <input id="hire-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form-grid">
            <div class="field">
              <label for="hire-company">Company</label>
              <input id="hire-company" name="company" type="text" autocomplete="organization" required />
            </div>

            <div class="field">
              <label for="hire-contact">Contact person</label>
              <input id="hire-contact" name="contact_name" type="text" autocomplete="name" required />
            </div>

            <div class="field">
              <label for="hire-email">Work email</label>
              <input id="hire-email" name="email" type="email" autocomplete="email" required />
            </div>

            <div class="field">
              <label for="hire-role">Role title</label>
              <input id="hire-role" name="role" type="text" placeholder="e.g. Analytics manager" required />
            </div>

            <div class="field">
              <label for="hire-location">Location</label>
              <input
                id="hire-location"
                name="location"
                type="text"
                placeholder="City, country or remote"
                autocomplete="address-level2"
                required
              />
            </div>

            <div class="field">
              <label for="hire-budget">Budget range</label>
              <input
                id="hire-budget"
                name="budget_range"
                type="text"
                placeholder="Your budget range"
                required
              />
              <p class="field-help">No salary figures are published on this site.</p>
            </div>

            <div class="field field-full">
              <label for="hire-urgency">Urgency</label>
              <select id="hire-urgency" name="urgency" required>
                <option value="">Select one</option>
                <option value="Hiring this month">Hiring this month</option>
                <option value="Hiring in 1-3 months">Hiring in the next 1–3 months</option>
                <option value="Exploring / next quarter">Exploring / next quarter</option>
              </select>
            </div>

            <div class="field field-full">
              <label for="hire-message">Brief and context</label>
              <textarea
                id="hire-message"
                name="message"
                rows="6"
                placeholder="What does the role need to achieve? Which skills matter most? What is the process and timeline?"
                required
              ></textarea>
            </div>

            <div class="checkbox-field">
              <input id="hire-consent" name="consent" type="checkbox" value="yes" required />
              <label for="hire-consent">
                I agree to be contacted about this brief and have read the
                <a href="/privacy/">privacy policy</a>.
              </label>
            </div>

            <div class="form-actions">
              <button class="button" type="submit">Send the hiring brief</button>
              <span class="form-help">We will reply with next steps or an honest no.</span>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
