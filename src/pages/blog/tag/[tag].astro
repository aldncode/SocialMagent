---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/BlogCard.astro';
import TagFilter from '../../../components/TagFilter.astro';
import {
  collectTags,
  getPublishedPosts,
  tagSlug,
  type BlogPost,
} from '../../../lib/blog';

export async function getStaticPaths() {
  const allPosts = await getPublishedPosts();
  const tags = collectTags(allPosts);

  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: {
      tagLabel: tag.label,
      tagSlug: tag.slug,
      posts: allPosts.filter((post) =>
        post.data.tags.some((postTag) => tagSlug(postTag) === tag.slug),
      ),
      tags,
    },
  }));
}

interface Props {
  tagLabel: string;
  tagSlug: string;
  posts: BlogPost[];
  tags: { label: string; slug: string; count: number }[];
}

const { tagLabel, tagSlug: activeSlug, posts, tags } = Astro.props;
---

<BaseLayout
  title={`Posts tagged “${tagLabel}”`}
  description={`Practical articles tagged ${tagLabel} from the Social Magent blog.`}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog/' },
    { label: tagLabel },
  ]}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">Tag</p>
      <h1>{tagLabel}</h1>
      <p class="lede">
        {posts.length} {posts.length === 1 ? 'article' : 'articles'} on this
        topic.
      </p>
      <p><a class="text-link" href="/blog/">← All articles</a></p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <TagFilter tags={tags} active={activeSlug} />

      <div class="post-grid post-grid-2">
        {
          posts.map((post) => (
            <BlogCard post={post} headingLevel="h2" />
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
