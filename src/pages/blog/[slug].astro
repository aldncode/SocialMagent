---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import BlogCard from '../../components/BlogCard.astro';
import {
  authorName,
  formatDate,
  getPublishedPosts,
  postSlug,
  readingTime,
  relatedPosts,
  tagUrl,
  toIsoDate,
  type BlogPost,
} from '../../lib/blog';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = await getPublishedPosts();
const related = relatedPosts(post, allPosts, 3);

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  heroImage,
  sources,
} = post.data;
const author = authorName(post);
const minutes = readingTime(post.body);
const showToc = headings.filter((h) => h.depth === 2 || h.depth === 3).length >= 3;
const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = heroImage
  ? new URL(heroImage.src, site.url).href
  : new URL('/images/og-default.png', site.url).href;

const articleLd = {
  '@type': 'Article',
  '@id': `${canonical}#article`,
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author:
    author === site.founder.name
      ? { '@type': 'Person', '@id': `${site.url}/#founder`, name: author }
      : { '@type': 'Person', name: author },
  publisher: { '@id': `${site.url}/#organization` },
  image: [imageUrl],
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  keywords: tags.join(', '),
  articleSection: tags[0] ?? 'Marketing',
  inLanguage: 'en-IN',
  isAccessibleForFree: true,
};
---

<BaseLayout
  title={title}
  description={description}
  image={imageUrl}
  imageAlt={`Cover illustration for ${title}`}
  type="article"
  structuredData={[articleLd]}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Blog', href: '/blog/' },
    { label: title },
  ]}
>
  <article>
    <header class="article-header">
      <div class="container">
        <div class="article-main">
          <h1>{title}</h1>
          <p class="lede">{description}</p>
          <div class="article-meta">
            <span>By {author}</span>
            <span aria-hidden="true">·</span>
            <span>
              <time datetime={toIsoDate(pubDate)}>Published {formatDate(pubDate)}</time>
            </span>
            <span aria-hidden="true">·</span>
            <span>{minutes} min read</span>
            {updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  Updated on{' '}
                  <time datetime={toIsoDate(updatedDate)}>{formatDate(updatedDate)}</time>
                </span>
              </>
            )}
          </div>
          {tags.length > 0 && (
            <ul class="tag-list" aria-label="Tags">
              {tags.map((tag) => (
                <li><a class="tag" href={tagUrl(tag)}>{tag}</a></li>
              ))}
            </ul>
          )}
        </div>
      </div>
    </header>

    {heroImage && (
      <div class="container">
        <div class="article-hero">
          <Image
            src={heroImage}
            alt={`Illustration for ${title}`}
            width={1600}
            height={900}
            widths={[640, 900, 1200, 1600]}
            sizes="(max-width: 1140px) 92vw, 1140px"
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    )}

    <div class="container">
      <div class:list={['article-layout', { 'has-toc': showToc }]}>
        <div class="article-main">
          <div class="prose article-body">
            <Content />
          </div>

          <footer class="article-footer">
            {sources && sources.length > 0 && (
              <section class="sources" aria-labelledby="sources-heading">
                <h2 id="sources-heading">Sources and further reading</h2>
                <ul>
                  {sources.map((source) => (
                    <li>
                      <a href={source.url} rel="noopener noreferrer" target="_blank">
                        {source.title}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )}

            <AuthorBox author={author} />
          </footer>
        </div>

        {showToc && <TableOfContents headings={headings} />}
      </div>
    </div>

    {related.length > 0 && (
      <section class="section-tight section-divider related" aria-labelledby="related-heading">
        <div class="container">
          <div class="section-head">
            <div>
              <p class="eyebrow">Keep reading</p>
              <h2 id="related-heading">Related articles</h2>
            </div>
            <a class="text-link" href="/blog/">All articles →</a>
          </div>
          <div class="post-grid">
            {related.map((relatedPost) => (
              <BlogCard post={relatedPost} headingLevel="h3" />
            ))}
          </div>
        </div>
      </section>
    )}

    <div class="container">
      <p class="form-help">
        Found something useful? Share it with someone who is building their
        marketing career. Corrections are welcome at
        <a href={`mailto:${site.email}`}> {site.email}</a>.
      </p>
    </div>
  </article>
</BaseLayout>
