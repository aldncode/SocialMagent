---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Newsletter"
  description="Occasional practical notes on digital marketing, analytics and careers, plus new free resources from Social Magent."
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Newsletter' },
  ]}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">Newsletter</p>
      <h1>A useful email, not a content avalanche.</h1>
      <p class="lede">
        Occasional notes on marketing, analytics and careers, plus new resources
        when they are ready. Written for people doing the work or trying to get
        into it.
      </p>
    </div>
  </section>

  <section class="section-tight">
    <div class="container">
      <div class="split">
        <div>
          <h2>What you will get</h2>
          <ul class="pillar-list">
            <li class="pillar">
              <h3>New free resources</h3>
              <p>Checklists, worksheets and templates as they are published.</p>
            </li>
            <li class="pillar">
              <h3>Practical notes</h3>
              <p>
                Short explanations of marketing and analytics ideas you can use
                at work or in an interview.
              </p>
            </li>
            <li class="pillar">
              <h3>Honest updates</h3>
              <p>
                News about training and hiring when there is something real to
                share — not a weekly countdown.
              </p>
            </li>
          </ul>
        </div>

        <div>
          <NewsletterSignup
            id="newsletter-page-email"
            heading="Join the list"
            text="One field. Occasional emails. Unsubscribe whenever you like."
          />

          <div class="card card-spaced">
            <h2>How we handle your email</h2>
            <p>
              Email addresses are stored by the newsletter provider once the
              form is connected, not in this website's code. We will not sell
              your address or add you to unrelated lists.
            </p>
            <p class="muted">
              Read the <a href="/privacy/">privacy policy</a> or email
              <a href={`mailto:${site.email}`}>{site.email}</a> with questions.
            </p>
            {/* TODO: Paste the Beehiiv or Kit form action into src/config/site.ts. */}
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
