---
import BaseLayout from '../layouts/BaseLayout.astro';
import FormNote from '../components/FormNote.astro';
import { site } from '../config/site';

const endpoint = site.forms.talentNetworkEndpoint;
const fallback = `mailto:${site.email}?subject=${encodeURIComponent(
  'Talent network signup',
)}`;
const action = endpoint || fallback;
const isFallback = endpoint.length === 0;
---

<BaseLayout
  title="Join the talent network"
  description="Join the Social Magent talent network for digital marketing, social media and marketing analytics roles. Candidates are never charged a fee."
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Talent network' },
  ]}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">For candidates</p>
      <h1>Join the talent network.</h1>
      <p class="lede">
        Share your experience and what you are looking for. When a genuine brief
        fits your skills, we will get in touch. There is no fee for candidates —
        now or later.
      </p>
    </div>
  </section>

  <div class="container">
    <div class="notice notice-info">
      <p>
        <strong>Candidates are never charged a fee.</strong> We do not ask for
        payment for applications, CV reviews, introductions or placements. If
        anyone asks you to pay on our behalf, please tell us.
      </p>
    </div>
  </div>

  <section class="section-tight" aria-labelledby="talent-form-heading">
    <div class="container split">
      <div>
        <h2 id="talent-form-heading">How it works</h2>
        <ol class="pillar-list">
          <li class="pillar">
            <h3>1. Share your details</h3>
            <p>
              Tell us your current role, skills, experience and the kind of role
              you want next.
            </p>
          </li>
          <li class="pillar">
            <h3>2. We review the fit</h3>
            <p>
              If your profile matches an employer brief, we will contact you
              with the context before sharing anything further.
            </p>
          </li>
          <li class="pillar">
            <h3>3. You decide</h3>
            <p>
              You choose whether to explore the opportunity. We will not send
              your details to an employer without your agreement.
            </p>
          </li>
        </ol>

        <div class="note-strip">
          <p>
            <strong>Who this is for:</strong> people working in or moving into
            digital marketing, social media, content, performance marketing,
            marketing analytics or related roles. Students and early-career
            candidates are welcome.
          </p>
        </div>

        <p class="form-privacy">
          Prefer email? Send a short introduction or your LinkedIn profile to
          <a
            href={`mailto:${site.email}?subject=${encodeURIComponent('Talent network enquiry')}`}
          >
            {site.email}
          </a>.
        </p>
      </div>

      <div class="form-card">
        <FormNote endpoint={endpoint} subject="Talent network signup" />

        <form
          action={action}
          method="post"
          enctype={isFallback ? 'text/plain' : undefined}
        >
          <input type="hidden" name="_subject" value="New talent network signup" />
          <div class="honeypot" aria-hidden="true">
            <label for="talent-gotcha">Leave this field empty</label>
            <input id="talent-gotcha" type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
          </div>

          <div class="form-grid">
            <div class="field">
              <label for="talent-name">Full name</label>
              <input id="talent-name" name="name" type="text" autocomplete="name" required />
            </div>

            <div class="field">
              <label for="talent-email">Email</label>
              <input id="talent-email" name="email" type="email" autocomplete="email" required />
            </div>

            <div class="field">
              <label for="talent-phone">Phone <span class="optional">(optional)</span></label>
              <input id="talent-phone" name="phone" type="tel" autocomplete="tel" />
            </div>

            <div class="field">
              <label for="talent-role">Current role</label>
              <input
                id="talent-role"
                name="current_role"
                type="text"
                placeholder="e.g. Social media executive"
                autocomplete="organization-title"
                required
              />
            </div>

            <div class="field field-full">
              <label for="talent-skills">Skills</label>
              <textarea
                id="talent-skills"
                name="skills"
                rows="4"
                placeholder="Tools, channels and strengths. For example: content planning, Meta Ads, Google Analytics, copywriting, reporting."
                required
              ></textarea>
              <p class="field-help">
                A short, honest list is more useful than every tool you have
                opened once.
              </p>
            </div>

            <div class="field">
              <label for="talent-experience">Years of experience</label>
              <select id="talent-experience" name="years_experience" required>
                <option value="">Select one</option>
                <option value="Student / no formal experience">Student / no formal experience</option>
                <option value="Less than 1 year">Less than 1 year</option>
                <option value="1-3 years">1–3 years</option>
                <option value="3-5 years">3–5 years</option>
                <option value="5-8 years">5–8 years</option>
                <option value="8+ years">8+ years</option>
              </select>
            </div>

            <div class="field">
              <label for="talent-location">Location</label>
              <input
                id="talent-location"
                name="location"
                type="text"
                placeholder="City and country"
                autocomplete="address-level2"
                required
              />
            </div>

            <div class="field">
              <label for="talent-salary">
                Expected salary range <span class="optional">(optional)</span>
              </label>
              <input
                id="talent-salary"
                name="expected_salary"
                type="text"
                placeholder="Your expected range"
              />
              <p class="field-help">No salary figures or benchmarks are published on this site.</p>
            </div>

            <div class="field">
              <label for="talent-notice">
                Notice period <span class="optional">(optional)</span>
              </label>
              <input
                id="talent-notice"
                name="notice_period"
                type="text"
                placeholder="e.g. 30 days"
              />
            </div>

            <div class="field field-full">
              <label for="talent-linkedin">
                LinkedIn URL <span class="optional">(optional)</span>
              </label>
              <input
                id="talent-linkedin"
                name="linkedin"
                type="url"
                placeholder="https://www.linkedin.com/in/your-profile"
                autocomplete="url"
              />
            </div>

            <div class="checkbox-field">
              <input id="talent-consent" name="consent" type="checkbox" value="yes" required />
              <label for="talent-consent">
                I agree to Social Magent storing these details in its
                third-party form and recruitment tools so it can contact me
                about relevant roles. I have read the
                <a href="/privacy/">privacy policy</a>.
              </label>
            </div>

            <div class="form-actions">
              <button class="button" type="submit">Join the talent network</button>
              <span class="form-help">We aim to reply when there is a genuine fit.</span>
            </div>
          </div>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>
