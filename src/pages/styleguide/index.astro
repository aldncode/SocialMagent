  <!-- ============================ NAVIGATION ============================ -->
  <section class="sg-section">
    <div class="container">
      <h2 class="sg-section__title">Navigation helpers</h2>
      <p class="sg-section__intro">
        Breadcrumb, pagination, tabs (arrow-key navigable), accordion (native, no
        JavaScript) and filter chips.
      </p>

      <p class="sg-sub">Breadcrumb</p>
      <Breadcrumb
        items={[
          { label: 'Home', href: '/' },
          { label: 'Services', href: '/services' },
          { label: 'Current page' },
        ]}
      />

      <p class="sg-sub">Pagination</p>
      <Pagination current={3} total={6} />

      <p class="sg-sub">Tabs</p>
      <Tabs
        id="demo-tabs"
        tabs={[
          { label: 'Tab one', content: 'Placeholder panel content for tab one. Use Left and Right arrow keys to move between tabs.' },
          { label: 'Tab two', content: 'Placeholder panel content for tab two.' },
          { label: 'Tab three', content: 'Placeholder panel content for tab three.' },
        ]}
      />

      <p class="sg-sub">Accordion</p>
      <Accordion items={accordionItems} />

      <p class="sg-sub">Tag / filter chips</p>
      <div class="sg-row">
        <Chip>Default chip</Chip>
        <Chip active>Active filter</Chip>
        <Chip as="button">Button chip</Chip>
        <Chip as="button" active aria-pressed="true">Pressed chip</Chip>
        <Chip removable>Removable chip</Chip>
        <Chip as="a" href="#">Link chip</Chip>
      </div>

      <p class="sg-sub">Navigation on the dark surface</p>
      <div class="sg-dark">
        <div class="sg-row" style="margin-bottom: var(--space-3);">
          <Breadcrumb
            items={[{ label: 'Home', href: '/' }, { label: 'Current page' }]}
          />
        </div>
        <div class="sg-row" style="margin-bottom: var(--space-3);">
          <Pagination current={1} total={4} />
        </div>
        <div class="sg-row">
          <Chip>Default</Chip>
          <Chip active>Active filter</Chip>
          <Chip as="button">Button chip</Chip>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ UTILITIES ============================ -->
  <section class="sg-section">
    <div class="container">
      <h2 class="sg-section__title">Utility elements</h2>
      <p class="sg-section__intro">
        Dividers, overline labels, pull quote, notices and a data table.
      </p>

      <p class="sg-sub">Dividers</p>
      <Divider />
      <Divider variant="strong" />
      <Divider variant="short" />

      <p class="sg-sub">Overline label</p>
      <div class="sg-row">
        <Overline text="Plain overline" />
        <span class="overline overline-rule" style="flex: 1; min-width: 200px;">Overline with rule</span>
      </div>

      <p class="sg-sub">Pull quote</p>
      <div style="max-width: var(--measure);">
        <PullQuote cite="Placeholder attribution — placeholder quote">
          A placeholder quotation used to demonstrate the pull-quote component. No real
