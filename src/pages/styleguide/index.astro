  { label: 'lead — 24px intro', cls: 'lead', text: 'A lead paragraph introduces a section in one or two confident sentences.' },
  { label: 'body — 16px / 1.6, ~70ch measure', cls: 'body-text', text: 'Body copy sits at a comfortable measure of roughly 70 characters so long-form reading stays easy on every screen.' },
  { label: 'small — 14px / 1.55', cls: 'small', text: 'Secondary supporting text for interface elements.' },
  { label: 'caption — 13px / 1.5', cls: 'caption', text: 'Timestamps, helper text and fine print.' },
