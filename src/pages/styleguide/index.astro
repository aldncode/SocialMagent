        head={['Column one', 'Column two', 'Column three']}
        rows={[
          ['Placeholder row', 'Placeholder value', 'Placeholder value'],
          ['Placeholder row', 'Placeholder value', 'Placeholder value'],
          ['Placeholder row', 'Placeholder value', 'Placeholder value'],
        ]}
      />

      <p class="sg-sub">Utilities on the dark surface</p>
      <div class="sg-dark">
        <PullQuote cite="Placeholder attribution">
          Placeholder pull quote on the dark surface.
        </PullQuote>
        <div style="margin-top: var(--space-3);">
          <Notice variant="info" title="Information">Placeholder notice on dark.</Notice>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
