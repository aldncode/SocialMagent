        <Notice variant="info" title="Information">Placeholder informational message.</Notice>
        <Notice variant="success" title="Success">Placeholder success message.</Notice>
        <Notice variant="warning" title="Warning">Placeholder warning message.</Notice>
        <Notice variant="error" title="Error">Placeholder error message.</Notice>
