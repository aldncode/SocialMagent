---
// Privacy — short starter template (to be reviewed by owner).
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Notice from '../components/Notice.astro';
import { legal } from '../data/services';
---

<BaseLayout
  title={legal.privacy.meta.title}
  description={legal.privacy.meta.description}
  path="/privacy"
>
  <Hero
    variant="compact"
    title="Privacy policy"
    lead={legal.privacy.updated}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Privacy' }]}
    actions={false}
  />

  <section class="section">
    <div class="container container--content">
      <Notice variant="warning" title="To be reviewed by owner">
        {legal.privacy.reviewNote}
      </Notice>

      <div class="legal-body" style="margin-top: var(--space-6);">
        {
          legal.privacy.sections.map((section) => (
            <div style="margin-bottom: var(--space-5);">
              <h2>{section.heading}</h2>
              <p class="body-text">{section.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
