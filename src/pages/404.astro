---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---

<BaseLayout
  title="Page not found"
  description={`The page you were looking for does not exist. Explore ${site.name} resources, articles and hiring pages instead.`}
  noindex
>
  <section class="not-found">
    <div class="container not-found-inner">
      <p class="display-code" aria-hidden="true">404</p>
      <h1>That page has moved on.</h1>
      <p class="lede">
        The link may be old, or the page may not exist yet. Here are a few useful
        places to continue.
      </p>
      <div class="page-actions center-actions">
        <a class="button" href="/">Go home</a>
        <a class="button button-secondary" href="/blog/">Read the blog</a>
        <a class="button button-ghost" href="/resources/">Free resources</a>
      </div>
      <p class="muted">
        Still stuck? Email <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>
