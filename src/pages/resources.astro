---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import { resources } from '../data/resources';
---

<BaseLayout
  title="Free resources"
  description="Free checklists, worksheets and templates for digital marketing, social media and marketing analytics careers."
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Free resources' },
  ]}
>
  <section class="page-hero">
    <div class="container page-hero-inner">
      <p class="eyebrow">Free resources</p>
      <h1>Useful things you can use today.</h1>
      <p class="lede">
        Practical checklists and worksheets for learning, job hunting and doing
        the work. No inflated claims, no 40-page PDFs that could have been a
        paragraph.
      </p>
      <div class="page-actions">
        <a class="button" href="/newsletter/">Get new resources by email</a>
        <a class="button button-secondary" href="/blog/">Read the blog</a>
      </div>
    </div>
  </section>

  <section class="section-tight" aria-labelledby="resources-heading">
    <div class="container">
      <div class="section-head">
        <div>
          <h2 id="resources-heading">The resource library</h2>
          <p>
            The basics are free to download. Some deeper templates are delivered
            by email.
          </p>
        </div>
      </div>

      <div class="resource-grid">
        {
          resources.map((resource) => (
            <article
              class:list={['resource-card', { 'is-gated': resource.gated }]}
            >
              <p class="resource-meta">
                <span>{resource.format}</span>
                <span aria-hidden="true">·</span>
                <span>{resource.category}</span>
                {resource.gated && <span class="badge-gated">Email-gated</span>}
              </p>
              <h2>{resource.title}</h2>
              <p>{resource.description}</p>
              <a
                class:list={['button', resource.gated ? 'button-ghost' : 'button-secondary']}
                href={resource.href}
                download={resource.gated ? undefined : true}
              >
                {resource.gated ? 'Get it by email' : 'Download free'}
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-label="Newsletter signup">
    <div class="container">
      <NewsletterSignup
        id="resources-newsletter-email"
        heading="New resources, when they are ready"
        text="Join the list for practical notes and new free downloads. You can unsubscribe whenever you like."
      />
    </div>
  </section>
</BaseLayout>
