---
/**
 * The shared page shell: <head> metadata, header, breadcrumbs, content slot,
 * footer, analytics (optional) and site-wide structured data.
 */
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ConsentNotice from '../components/ConsentNotice.astro';
import { site, socialLinks, analyticsEnabled } from '../config/site';
import '../styles/global.css';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  brandSuffix?: boolean;
  crumbs?: Crumb[];
  /** Extra JSON-LD objects for this page, e.g. an Article. */
  structuredData?: Record<string, unknown>[];
}

const {
  title,
  description,
  image,
  imageAlt,
  type = 'website',
  noindex = false,
  brandSuffix = true,
  crumbs = [],
  structuredData = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;

const graph: Record<string, unknown>[] = [
  {
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    logo: new URL('/favicon.svg', site.url).href,
    description: site.description,
    email: site.email,
    founder: { '@id': `${site.url}/#founder` },
    sameAs: socialLinks.map((link) => link.href),
  },
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    description: site.description,
    inLanguage: 'en-IN',
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@type': 'Person',
    '@id': `${site.url}/#founder`,
    name: site.founder.name,
    jobTitle: `${site.founder.role}, ${site.name}`,
    description: site.founder.shortBio,
    url: new URL('/about/', site.url).href,
    worksFor: { '@id': `${site.url}/#organization` },
    knowsAbout: [
      'Digital marketing',
      'Social media marketing',
      'Marketing analytics',
      'Marketing careers',
    ],
    sameAs: socialLinks.map((link) => link.href),
  },
];

if (crumbs.length > 0) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.label,
      item: crumb.href ? new URL(crumb.href, site.url).href : canonical,
    })),
  });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [...graph, ...structuredData],
};

const safeJsonLd = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#17141f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <SEO
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      type={type}
      noindex={noindex}
      brandSuffix={brandSuffix}
    />
    <script type="application/ld+json" set:html={safeJsonLd} />

    {analyticsEnabled && site.analytics.provider === 'plausible' && (
      <script
        is:inline
        defer
        data-domain={site.analytics.plausibleDomain}
        src="https://plausible.io/js/script.js"
      />
    )}
    {analyticsEnabled && site.analytics.provider === 'cloudflare' && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: site.analytics.cloudflareToken })}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      {crumbs.length > 0 && (
        <div class="container breadcrumb-wrap">
          <Breadcrumbs items={crumbs} />
        </div>
      )}
      <slot />
    </main>
    <Footer />
    {analyticsEnabled && <ConsentNotice />}
  </body>
</html>
