---
// Select with label, helper and error/success states.
interface Props {
  label: string;
  name: string;
  options: { label: string; value: string }[];
  helper?: string;
  message?: string;
  state?: 'default' | 'error' | 'success';
  required?: boolean;
}
const {
  label,
  name,
  options,
  helper,
  message,
  state = 'default',
  required = false,
} = Astro.props;

const id = name;
---

<div class={`field${state !== 'default' ? ` field--${state}` : ''}`}>
  <label class="field__label" for={id}>
    {label}
    {required && <span class="field__required" aria-hidden="true">*</span>}
  </label>
  <select
    class="field__control"
    id={id}
    name={name}
    required={required}
    aria-invalid={state === 'error' ? 'true' : undefined}
    aria-describedby={message && state !== 'default' ? `${id}-message` : helper ? `${id}-helper` : undefined}
  >
    {
      options.map((option) => (
        <option value={option.value}>{option.label}</option>
      ))
    }
  </select>
  {helper && <p class="field__helper" id={`${id}-helper`}>{helper}</p>}
  {message && (
    <p class={`field__message field__message--${state}`} id={`${id}-message`} role={state === 'error' ? 'alert' : undefined}>
      {message}
    </p>
  )}
</div>
