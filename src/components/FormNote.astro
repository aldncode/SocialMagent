---
/**
 * Explains what happens to form data and, when an endpoint is not configured,
 * shows a clear fallback instead of pretending the form is live.
 */
import { site } from '../config/site';

interface Props {
  endpoint: string;
  subject: string;
  candidateNotice?: boolean;
}

const { endpoint, subject, candidateNotice = false } = Astro.props;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent(subject)}`;
---

{
  endpoint.length === 0 && (
    <div class="notice notice-warning">
      {/* TODO: Add a form endpoint in src/config/site.ts to switch this live. */}
      <p>
        <strong>This form is not connected yet.</strong> We are finishing the
        setup, so the submit button will open your email app instead. You can
        also <a href={mailto}>email us directly</a>.
      </p>
    </div>
  )
}

<p class="form-privacy">
  This site does not store form submissions. {endpoint.length > 0
    ? 'Your information is processed by our third-party form provider and handled under our '
    : 'If you use the email fallback, your message is handled under our '}
  <a href="/privacy/">privacy policy</a>.
</p>

{
  candidateNotice && (
    <p class="form-privacy">
      <strong>Candidates are never charged a fee.</strong> We do not ask for
      payment from candidates for introductions, CV reviews or placements.
    </p>
  )
}
