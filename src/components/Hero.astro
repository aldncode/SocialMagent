---
// Hero with three variants:
//   variant="block"      — large headline in a dark block + placeholder image
//   variant="editorial"  — light hero: overline, headline, lead, two buttons
//   variant="compact"    — small page hero with breadcrumb
import Button from './Button.astro';
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  variant?: 'block' | 'editorial' | 'compact';
  overline?: string;
  title: string;
  lead?: string;
  breadcrumbs?: { label: string; href?: string }[];
  actions?: boolean; // set false to render headline only
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  variant = 'editorial',
  overline,
  title,
  lead,
  breadcrumbs = [],
  actions = true,
  primaryLabel = 'Primary action',
  primaryHref = '/contact',
  secondaryLabel = 'Secondary action',
  secondaryHref = '/services',
} = Astro.props;
---

<section class={`hero hero--${variant}`}>
  {
    variant === 'block' ? (
      <div class="container hero__grid">
        <div class="hero__text">
          {overline && <span class="overline">{overline}</span>}
          <h1 class="display">{title}</h1>
          {lead && <p class="lead">{lead}</p>}
          {actions && (
            <div class="hero__actions">
              <Button variant="primary" href={primaryHref}>
                {primaryLabel}
              </Button>
              <Button variant="text" href={secondaryHref}>
                {secondaryLabel}
              </Button>
            </div>
          )}
        </div>
        <div class="hero__media">
          <div class="placeholder-media" role="img" aria-label="Placeholder image area">
            <span class="placeholder-media__label">Placeholder image</span>
          </div>
        </div>
      </div>
    ) : variant === 'compact' ? (
      <div class="container">
        <Breadcrumb items={breadcrumbs} />
        <h1>{title}</h1>
        {lead && <p class="lead">{lead}</p>}
      </div>
    ) : (
      <div class="container hero__inner">
        {overline && <span class="overline">{overline}</span>}
        <h1 class="display" style="margin-top: var(--space-2);">{title}</h1>
        {lead && <p class="lead">{lead}</p>}
        {actions && (
          <div class="hero__actions">
            <Button variant="primary" href={primaryHref}>
              {primaryLabel}
            </Button>
            <Button variant="secondary" href={secondaryHref}>
              {secondaryLabel}
            </Button>
          </div>
        )}
      </div>
    )
  }
</section>
