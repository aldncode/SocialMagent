---
/**
 * Reusable newsletter signup.
 *
 * While no action URL is set in src/config/site.ts, this deliberately shows a
 * clearly labelled setup placeholder plus a working mailto fallback.
 */
import { site, mailtoSubscribe } from '../config/site';

interface Props {
  id: string;
  heading?: string;
  text?: string;
  compact?: boolean;
}

const {
  id,
  heading = 'Get the useful bits by email',
  text = 'Occasional practical notes on marketing, analytics and careers. No noise, no daily newsletter.',
  compact = false,
} = Astro.props;

const connected = site.newsletter.action.length > 0;
const helpId = `${id}-help`;
---

<section class:list={['newsletter', { 'newsletter-compact': compact }]} aria-labelledby={`${id}-heading`}>
  <div class="newsletter-intro">
    <p class="eyebrow">Newsletter</p>
    <h2 id={`${id}-heading`} class="newsletter-heading">{heading}</h2>
    <p class="newsletter-text">{text}</p>
  </div>

  {
    connected ? (
      <form
        class="newsletter-form"
        action={site.newsletter.action}
        method={site.newsletter.method}
      >
        <label class="sr-only" for={id}>
          Email address
        </label>
        <div class="newsletter-row">
          <input
            id={id}
            name={site.newsletter.emailFieldName}
            type="email"
            autocomplete="email"
            inputmode="email"
            placeholder="you@example.com"
            required
            aria-describedby={helpId}
          />
          <button class="button" type="submit">Subscribe</button>
        </div>
        {Object.entries(site.newsletter.hiddenFields).map(([name, value]) => (
          <input type="hidden" name={name} value={value} />
        ))}
        <p class="form-help" id={helpId}>
          {site.newsletter.consentNote}{' '}
          <a href="/privacy/">Privacy policy</a>.
        </p>
      </form>
    ) : (
      <div class="newsletter-placeholder">
        {/* TODO: Connect Beehiiv or Kit by adding an action URL in site.ts. */}
        <p class="setup-badge">Newsletter form not connected yet</p>
        <p class="form-help" id={helpId}>
          The hosted signup form is being set up. For now you can subscribe by
          email and we will add you manually.
        </p>
        <a class="button" href={mailtoSubscribe}>Subscribe by email</a>
        <p class="form-help">
          You will get occasional emails from Social Magent. You can unsubscribe
          at any time. See our <a href="/privacy/">privacy policy</a>.
        </p>
      </div>
    )
  }
</section>
