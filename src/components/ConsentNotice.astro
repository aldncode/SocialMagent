---
/**
 * Only rendered when analytics is enabled in src/config/site.ts.
 * Both supported analytics providers are cookieless; this notice explains that
 * plainly and lets visitors dismiss it. The choice is stored in localStorage.
 */
---

<div class="consent-notice" role="region" aria-label="Analytics notice" data-consent hidden>
  <p>
    We use privacy-friendly, cookieless analytics to understand which pages are
    useful. No advertising profiles are built. Read the
    <a href="/privacy/">privacy policy</a>.
  </p>
  <div class="consent-actions">
    <button class="button button-small" type="button" data-consent-accept>
      Got it
    </button>
    <a class="text-link" href="/privacy/">Learn more</a>
  </div>
</div>

<script is:inline>
  (() => {
    const notice = document.querySelector('[data-consent]');
    if (!notice) return;
    const key = 'socialmagent-analytics-notice';
    try {
      if (window.localStorage.getItem(key) === 'dismissed') return;
    } catch {
      // If storage is blocked, still show the notice.
    }
    notice.hidden = false;
    notice.querySelector('[data-consent-accept]')?.addEventListener('click', () => {
      notice.hidden = true;
      try {
        window.localStorage.setItem(key, 'dismissed');
      } catch {
        // Ignore storage errors.
      }
    });
  })();
</script>
