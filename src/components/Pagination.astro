---
// Pagination — numbered pages with prev/next; current page uses aria-current.
interface Props {
  current: number;
  total: number;
}
const { current, total } = Astro.props;

const pages = Array.from({ length: total }, (_, i) => i + 1);
---

<nav class="pagination" aria-label="Pagination">
  <a
    class="pagination__link"
    href="#"
    aria-disabled={current === 1 ? 'true' : undefined}
    tabindex={current === 1 ? -1 : undefined}
  >
    ← <span class="visually-hidden">Previous page</span>
  </a>
  {
    pages.map((page) =>
      page === current ? (
        <span class="pagination__link" aria-current="page">
          {page}
          <span class="visually-hidden"> (current page)</span>
        </span>
      ) : (
        <a class="pagination__link" href="#">
          {page}
          <span class="visually-hidden"> page</span>
        </a>
      )
    )
  }
  <a
    class="pagination__link"
    href="#"
    aria-disabled={current === total ? 'true' : undefined}
    tabindex={current === total ? -1 : undefined}
  >
    <span class="visually-hidden">Next page</span> →
  </a>
</nav>
