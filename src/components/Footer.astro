---
// Footer — multi-column link groups, legal row, contact/social (hidden when unset).
// variant="dark" for the dark surface context (default on this site).
import Wordmark from './Wordmark.astro';
import { site } from '../config/site';
import { services, footerCopy } from '../data/services';

interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'dark' } = Astro.props;

const groups = [
  {
    title: footerCopy.groups.services,
    links: services.map((service) => ({
      label: service.navLabel,
      href: `/services#${service.id}`,
    })),
  },
  { title: footerCopy.groups.company, links: footerCopy.companyLinks },
  { title: footerCopy.groups.legal, links: footerCopy.legalLinks },
];
---

<footer class="site-footer" data-surface={variant === 'dark' ? 'dark' : undefined}>
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Wordmark />
        <p>{footerCopy.tagline}</p>
        {
          (site.email || site.phone) && (
            <p class="caption">
              {site.email && (
                <a href={`mailto:${site.email}`}>{site.email}</a>
              )}
              {site.email && site.phone && ' · '}
              {site.phone && <a href={`tel:${site.phone.replace(/\s+/g, '')}`}>{site.phone}</a>}
            </p>
          )
        }
      </div>
      {
        groups.map((group) => (
          <div class="footer__group">
            <p class="footer__group-title">{group.title}</p>
            <ul class="footer__links">
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="footer__bottom">
      <div class="footer__legal">
        <span>© {new Date().getFullYear()} {site.brand || 'Social Magent'}</span>
      </div>
      {
        site.linkedin && (
          <div class="footer__social">
            <a href={site.linkedin} rel="noopener noreferrer" target="_blank" aria-label="LinkedIn">
              LinkedIn
            </a>
          </div>
        )
      }
    </div>
  </div>
</footer>
