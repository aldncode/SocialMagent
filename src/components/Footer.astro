---
import NewsletterSignup from './NewsletterSignup.astro';
import { site, socialLinks } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label={`${site.name} home`}>
        <span class="brand-text">Social <em>Magent</em></span>
      </a>
      <p class="footer-tagline">{site.tagline}</p>
      <p class="footer-note">
        Digital marketing, social media and analytics careers. Free resources,
        practical training and honest hiring support.
      </p>
      <a class="footer-email" href={`mailto:${site.email}`}>{site.email}</a>

      {socialLinks.length > 0 && (
        <ul class="footer-social" aria-label="Social links">
          {socialLinks.map((link) => (
            <li>
              <a href={link.href} rel="me noopener noreferrer" target="_blank">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
      {/* TODO: Add LinkedIn and any optional social URLs in src/config/site.ts. */}
    </div>

    <nav class="footer-nav" aria-label="Explore">
      <h2>Explore</h2>
      <ul>
        <li><a href="/about/">About</a></li>
        <li><a href="/blog/">Blog</a></li>
        <li><a href="/resources/">Free resources</a></li>
        <li><a href="/newsletter/">Newsletter</a></li>
        <li><a href="/rss.xml">RSS feed</a></li>
      </ul>
    </nav>

    <nav class="footer-nav" aria-label="Work with us">
      <h2>Work with us</h2>
      <ul>
        <li><a href="/talent-network/">Join the talent network</a></li>
        <li><a href="/hire-talent/">Hire talent</a></li>
        <li><a href="/contact/">Contact</a></li>
      </ul>
    </nav>

    <div class="footer-newsletter">
      <NewsletterSignup
        id="footer-newsletter-email"
        text="Practical notes on marketing and analytics careers, sent occasionally."
        compact
      />
    </div>
  </div>

  <div class="container footer-bottom">
    <p>&copy; {year} {site.name}. Built in India.</p>
    <ul>
      <li><a href="/privacy/">Privacy</a></li>
      <li><a href="/terms/">Terms</a></li>
      <li><a href="/disclaimer/">Disclaimer</a></li>
    </ul>
  </div>
</footer>
