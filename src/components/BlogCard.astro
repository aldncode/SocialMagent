---
import { Image } from 'astro:assets';
import {
  formatDate,
  readingTime,
  postUrl,
  tagUrl,
  type BlogPost,
} from '../lib/blog';

interface Props {
  post: BlogPost;
  headingLevel?: 'h2' | 'h3';
}

const { post, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const minutes = readingTime(post.body);
const { title, description, tags, heroImage, pubDate } = post.data;
---

<article class="post-card">
  {
    heroImage && (
      <a class="post-card-media" href={postUrl(post)} tabindex="-1" aria-hidden="true">
        <Image
          src={heroImage}
          alt=""
          width={720}
          height={405}
          widths={[360, 540, 720]}
          sizes="(max-width: 700px) 92vw, (max-width: 1100px) 45vw, 360px"
          format="webp"
          quality={78}
          loading="lazy"
          decoding="async"
        />
      </a>
    )
  }
  <div class="post-card-body">
    <p class="post-meta">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span aria-hidden="true">·</span>
      <span>{minutes} min read</span>
    </p>
    <Heading class="post-card-title">
      <a href={postUrl(post)}>{title}</a>
    </Heading>
    <p>{description}</p>
    {
      tags.length > 0 && (
        <ul class="tag-list" aria-label="Tags">
          {tags.map((tag) => (
            <li>
              <a class="tag" href={tagUrl(tag)}>
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>
