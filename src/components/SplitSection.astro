---
// Split section — text column + media placeholder, either side.
import Button from './Button.astro';

interface Props {
  overline?: string;
  title: string;
  mediaFirst?: boolean;
  buttonLabel?: string;
  buttonHref?: string;
}
const {
  overline,
  title,
  mediaFirst = false,
  buttonLabel,
  buttonHref = '#',
} = Astro.props;
---

<div class={`split${mediaFirst ? ' split--media-first' : ''}`}>
  <div class="split__text">
    {overline && <span class="overline">{overline}</span>}
    <h2>{title}</h2>
    <p><slot /></p>
    {buttonLabel && (
      <Button variant="secondary" href={buttonHref}>
        {buttonLabel}
      </Button>
    )}
  </div>
  <div class="split__media">
    <div class="placeholder-media placeholder-media--light" role="img" aria-label="Placeholder image area">
      <span class="placeholder-media__label">Placeholder image</span>
    </div>
  </div>
</div>
