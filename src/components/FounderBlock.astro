---
// Founder block — portrait placeholder + name (or neutral "Founder" label).
import { site } from '../config/site';

interface Props {
  overline?: string;
  title: string;
  story: string;
  photoAlt?: string;
}
const { overline, title, story, photoAlt = 'Photo placeholder' } = Astro.props;

// TODO: set founderName in src/config/site.ts to show the real name
const founderName = site.founderName.trim();
---

<div class="split">
  <div class="split__media">
    <div
      class="person__portrait"
      role="img"
      aria-label={founderName ? `${founderName} — ${photoAlt}` : photoAlt}
    >
    </div>
  </div>
  <div class="split__text">
    {overline && <span class="overline">{overline}</span>}
    <h2>{title}</h2>
    <p>{story}</p>
    <p class="person__name">{founderName || 'Founder'}</p>
    <p class="person__role">{founderName ? 'Founder' : photoAlt}</p>
  </div>
</div>
