---
import { Image } from 'astro:assets';
import founderPhoto from '../assets/images/founder-placeholder.jpg';
import { site } from '../config/site';

interface Props {
  author: string;
}

const { author } = Astro.props;
const isFounder = author === site.founder.name;
const initials = author
  .split(/\s+/)
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<aside class="author-box" aria-label="About the author">
  {
    isFounder ? (
      <Image
        class="author-photo"
        src={founderPhoto}
        alt={`Portrait of ${site.founder.name}`}
        width={96}
        height={96}
        widths={[96, 192]}
        sizes="96px"
        format="webp"
        quality={80}
        loading="lazy"
      />
    ) : (
      <span class="author-initials" aria-hidden="true">{initials}</span>
    )
  }
  <div>
    <p class="eyebrow">Written by</p>
    <p class="author-name">{author}</p>
    <p class="author-bio">
      {isFounder ? site.founder.shortBio : 'Guest contributor at Social Magent.'}
    </p>
    {isFounder && <a class="text-link" href="/about/">More about the founder</a>}
  </div>
</aside>
