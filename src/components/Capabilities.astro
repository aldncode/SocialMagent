---
// Three-column capabilities section. Pass capability cards via the default slot.
interface Props {
  overline?: string;
  title: string;
  intro?: string;
}
const { overline, title, intro } = Astro.props;
---

<div>
  <header class="section-head">
    {overline && <span class="overline">{overline}</span>}
    <h2>{title}</h2>
    {intro && <p>{intro}</p>}
  </header>
  <div class="capabilities__grid">
    <slot />
  </div>
</div>
