---
// Quiet call-to-action band. variant="dark" for the dark surface context.
import Button from './Button.astro';

interface Props {
  title: string;
  buttonLabel?: string;
  buttonHref?: string;
  variant?: 'light' | 'dark';
}
const {
  title,
  buttonLabel = 'Talk to us',
  buttonHref = '/contact',
  variant = 'light',
} = Astro.props;
---

<section
  class={`cta-band${variant === 'dark' ? ' cta-band--dark' : ''}`}
  data-surface={variant === 'dark' ? 'dark' : undefined}
>
  <div class="container cta-band__inner">
    <div>
      <h2>{title}</h2>
      <p><slot /></p>
    </div>
    <Button variant="primary" href={buttonHref}>
      {buttonLabel}
    </Button>
  </div>
</section>
