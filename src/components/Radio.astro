---
// Radio — one option. Group several inside a <fieldset class="choice-group">
// with a <legend class="choice-group__legend">.
interface Props {
  label: string;
  name: string;
  value: string;
  checked?: boolean;
  helper?: string;
}
const { label, name, value, checked = false, helper } = Astro.props;
const id = `${name}-${value}`;
---

<label class="choice" for={id}>
  <input type="radio" id={id} name={name} value={value} checked={checked} />
  <span class="choice__text">
    {label}
    {helper && <span class="choice__helper">{helper}</span>}
  </span>
</label>
